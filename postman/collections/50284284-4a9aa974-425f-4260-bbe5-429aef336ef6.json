				{
					"name": "viewAllPosts",
					"event": [
						{
							"id": "47914733-9e10-4260-9009-3d6dde248b6b",
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Test: Successful posts retrieval",
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 3000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(3000);",
									"});",
									"",
									"pm.test(\"Response has JSON content type\", function () {",
									"    pm.response.to.have.header(\"Content-Type\");",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"// Test: Response is an array",
									"pm.test(\"Response is an array of posts\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"});",
									"",
									"// Test: Post structure validation",
									"if (pm.response.json().length > 0) {",
									"    pm.test(\"Each post has required fields\", function () {",
									"        var jsonData = pm.response.json();",
									"        jsonData.forEach(function(post) {",
									"            pm.expect(post).to.have.property(\"id\");",
									"            pm.expect(post).to.have.property(\"content\");",
									"            pm.expect(post).to.have.property(\"author\");",
									"            pm.expect(post).to.have.property(\"created_at\");",
									"        });",
									"    });",
									"",
									"    pm.test(\"Post fields have correct data types\", function () {",
									"        var jsonData = pm.response.json();",
									"        jsonData.forEach(function(post) {",
									"            pm.expect(post.id).to.be.a(\"number\");",
									"            pm.expect(post.content).to.be.a(\"string\");",
									"            pm.expect(post.author).to.be.a(\"number\");",
									"            pm.expect(post.created_at).to.be.a(\"string\");",
									"        });",
									"    });",
									"",
									"    pm.test(\"Post content is not empty\", function () {",
									"        var jsonData = pm.response.json();",
									"        jsonData.forEach(function(post) {",
									"            pm.expect(post.content).to.have.lengthOf.above(0);",
									"        });",
									"    });",
									"}",
									"",
									"// Test: Authentication required",
									"if (pm.response.code === 401) {",
									"    pm.test(\"Unauthorized response for missing authentication\", function () {",
									"        pm.expect(pm.response.code).to.equal(401);",
									"    });",
									"}"
								]
							}
						}
					],
					"id": "50284284-9514a1cb-ff21-4f45-adb5-fb4febe99956",
